{
  "name": "telegram-pdf-converter",
  "version": "1.0.0",
  "description": "Node.js service to convert HTML to PDF using Puppeteer",
  "main": "server.js", // Точка входа вашего приложения
  "scripts": {
    "start": "node server.js", // Команда для запуска в продакшене (Railway)
    "dev": "nodemon server.js", // Команда для локальной разработки (если установлен nodemon)
    "test-puppeteer-local": "node test-puppeteer.js" // Если хотите протестировать Puppeteer отдельно
  },
  "engines": {
    // Явно указываем требуемую версию Node.js.
    // Railway будет стараться соответствовать этому, но Nixpacks должен гарантировать это.
    "node": ">=20.11.0",
    "npm": ">=9.x.x"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "express": "^4.18.2",
    "puppeteer": "^22.10.0" // Используйте актуальную стабильную версию
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
